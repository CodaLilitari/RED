+/* Local engine observer: sample only actual native presentation calls in an active public fixture. */
+static void red_observe_frame(void)
+{
+    extern unsigned redPresentedModels, redPresentedFaces, redCachedHits, redThingQueries;
+    extern int redCacheActive(void);
+    static FILE* out;
+    static int initialized;
+    static unsigned int rows;
+    SithWorld* world = sithWorld_g_pCurrentWorld;
+    SithThing* player = sithPlayer_g_pLocalPlayerThing;
+    if (!world || !sith_bOpen || !sithWorld_bLoaded || !jkMain_bLevelActive || !player
+        || !world->aThings || world->numThingsLoaded <= 0
+        || !array_member(player,world->aThings,(size_t)world->numThingsLoaded,sizeof(SithThing))
+        || !world->aSectors || world->numSectors <= 0
+        || !array_member(player->sector,world->aSectors,(size_t)world->numSectors,sizeof(SithSector))) return;
+    if (!initialized) {
+        initialized = 1;
+        out=fopen("agent/route-frames.csv","wx");
+        if (!out) return;
+        fprintf(out,"frame,ns,sector,x,y,z,visibleSectors,sectorFrustums,alphaAdjoins,attachmentFlags,visibleModels,visibleModelFaces,thingCollisionQueries,floorCacheHits\n");
+        FILE* meta=fopen("agent/route-target.txt","wx");
+        if (meta) {
+            typedef const unsigned char* (*gl_string)(unsigned int);
+            gl_string strings=(gl_string)SDL_GL_GetProcAddress("glGetString");
+            int vsync=-1,width=0,height=0;
+            SDL_GL_GetSwapInterval(&vsync);
+            SDL_GetWindowSizeInPixels(displayWindow,&width,&height);
+            const char* r=strings?(const char*)strings(0x1F01):NULL;
+            const char* d=strings?(const char*)strings(0x1F02):NULL;
+            fprintf(meta,"renderer=%s\ndriver=%s\nwidth=%d\nheight=%d\nswapInterval=%d\nfpsCap=%d\n",
+                r?r:"unavailable",d?d:"unavailable",width,height,vsync,jkPlayer_fpslimit);
+            fclose(meta);
+            FILE* mode=fopen("agent/route-cache.txt","wx");
+            if (mode) { fprintf(mode,"%s\n",redCacheActive() ? "on" : "off"); fclose(mode); }
+        }
+    }
+    if (!out || rows++ >= 30000) return;
+    fprintf(out,"%llu,%llu,%d,%.6f,%.6f,%.6f,%d,%d,%d,%u,%u,%u,%u,%u\n",
+        (unsigned long long)presentedFrames,(unsigned long long)SDL_GetTicksNS(),(int)(player->sector-world->aSectors),
+        (double)player->position.x,(double)player->position.y,(double)player->position.z,sithRender_g_numVisibleSectors,
+        sithRender_numSecorFrustrums,sithRender_numAlphaAdjoins,player->attach_flags,
+        redPresentedModels,redPresentedFaces,redThingQueries,redCachedHits);
+    redPresentedModels=redPresentedFaces=redThingQueries=redCachedHits=0;
+    if (!(rows % 128)) fflush(out);
+}
