code
startup:
    if ((proxy < 0) || (GetThingType(proxy) != 7)) return;
    proxySig = GetThingSignature(proxy);
    SetThingGeoMode(proxy,0);
    SetThingCurGeoMode(proxy,0);
    if ((body < 0) || (GetThingType(body) != 7)) { call halt; return; }
    signature = GetThingSignature(body);
    epoch = GetFlexGameTime();
    track = PlayKey(body, walk, 5, 0);
    enabled = 1;
    if (IsMulti() && (IsServer() == 0)) return;
    SetPulse(0.05);
    return;
pulse:
    if (enabled == 0) return;
    if (IsMulti() && (IsServer() == 0)) return;
    if ((GetThingType(body) != 7) || (GetThingSignature(body) != signature) || ((GetThingFlags(body) & 0x80202) != 0)) { call halt; return; }
    if ((GetThingType(proxy) != 7) || (GetThingSignature(proxy) != proxySig) || ((GetThingFlags(proxy) & 0x80202) != 0)) { call halt; DestroyThing(body); return; }
    elapsed = (GetFlexGameTime() - epoch) * hz;
    while (elapsed >= 22644) elapsed = elapsed - 22644;
    edge = startEdge;
    previous = -1;
    call loadedge;
    while (elapsed >= duration)
    {
        elapsed = elapsed - duration;
        edge = (edge + 1) % 8;
        call loadedge;
    }
    u = elapsed / duration;
    pos = VectorAdd(VectorScale(ca,u*u*u),VectorAdd(VectorScale(cb,u*u),VectorAdd(VectorScale(cc,u),cd)));
    heading = VectorAdd(VectorScale(ca,3*u*u),VectorAdd(VectorScale(cb,2*u),cc));
    q = u * 64;
    sample = q | 0;
    if (sample > 63) sample = 63;
    q = q - sample;
    height = height0[sample] * (1-q) + height0[sample+1] * q;
    pos = VectorSet(VectorX(pos),VectorY(pos),height);
    heading = VectorSet(VectorX(heading),VectorY(heading),(height0[sample+1]-height0[sample])*64);
    call place;
    if (enabled == 0) return;
    if (VectorLen(heading) > 0.00001) SetThingLook(body,VectorScale(VectorNorm(heading),-1));
    SyncThingPos(body);
    call syncproxy;
    return;
syncproxy:
    if ((GetThingType(proxy) != 7) || (GetThingSignature(proxy) != proxySig) || ((GetThingFlags(proxy) & 0x80202) != 0)) return;
    if (GetThingSector(proxy) != GetThingSector(body)) TeleportThing(proxy,body);
    SetThingPos(proxy,GetThingPos(body));
    SetThingLook(proxy,GetThingLVec(body));
    SyncThingPos(proxy);
    return;
