place:
    call findsector;
    if (sectorId < 0) { call halt; return; }
    if (GetThingSector(body) != sectorId) TeleportThing(body, anchor0[sectorId]);
    SetThingPos(body, pos);
    return;
damaged:
    ReturnEx(0);
    if (enabled == 0) return;
    if (IsMulti() && (IsServer() == 0)) return;
    if ((GetSenderRef() != body) && (GetSenderRef() != proxy)) return;
    if ((GetThingType(body) != 7) || (GetThingSignature(body) != signature) || ((GetThingFlags(body) & 0x80202) != 0)) return;
    if ((GetThingType(proxy) != 7) || (GetThingSignature(proxy) != proxySig) || ((GetThingFlags(proxy) & 0x80202) != 0)) return;
    damage = GetParam(0);
    if (damage <= 0) return;
    remaining = remaining - damage;
    if (remaining > 0) return;
    call halt;
    DestroyThing(body);
    return;
killed:
    call removed;
    return;
removed:
    if (enabled == 0) return;
    if ((GetSenderRef() != body) && (GetSenderRef() != proxy)) return;
    if ((GetSenderRef() == body) && (GetThingSignature(body) != signature)) return;
    if ((GetSenderRef() == proxy) && (GetThingSignature(proxy) != proxySig)) return;
    call halt;
    if ((IsMulti() == 0) || IsServer())
        if ((GetThingType(body) == 7) && (GetThingSignature(body) == signature) && ((GetThingFlags(body) & 2) == 0)) DestroyThing(body);
    return;
shutdown:
    call halt;
    return;
halt:
    enabled = 0;
    SetPulse(0);
    if ((GetThingType(body) == 7) && (GetThingSignature(body) == signature))
        if (track >= 0) StopKey(body,track,0);
    track = -1;
    if ((IsMulti() == 0) || IsServer())
        if ((GetThingType(proxy) == 7) && (GetThingSignature(proxy) == proxySig) && ((GetThingFlags(proxy) & 2) == 0)) DestroyThing(proxy);
    return;

