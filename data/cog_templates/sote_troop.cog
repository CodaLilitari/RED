# Original retail-JK actor class for stock-Kyle-rig SOTE body ports.
# AI, projectile and puppet come from template. No stock ST joint amputation.
# Class instances can be shared: no event state spans a Sleep or timer.

symbols
template    energyDrop=+dstrifle       local
thing       victim=-1                    local
thing       pickup=-1                    local
message     damaged
message     killed
message     created
thing arStunActor=-1 local
message user6
end

code
created:
    victim = GetSenderRef();
    if (victim < 0) return;
    if (GetThingType(victim) != 2) return;
    SetArmedMode(victim, 1);
    return;

damaged:
    ReturnEx(GetParam(0));
    return;

killed:
    victim = GetSenderRef();
    if (victim < 0) return;
    if (GetThingType(victim) != 2) return;
    pickup = CreateThing(energyDrop, victim);
    if (pickup >= 0) SetLifeLeft(pickup, 200);
    return;

# SOTE ARSENAL: explicit native-AI stun support
user6:
    ReturnEx(0);
    if (IsMulti()) return;
    if (GetParam(1) != 6037) return;
    arStunActor = GetParam(0);
    if (arStunActor < 0) return;
    if (GetThingType(arStunActor) != 2) return;
    if (GetThingHealth(arStunActor) <= 0) return;
    if (GetThingClassCog(arStunActor) != GetSelfCog()) return;
    if (GetActorFlags(arStunActor) & 0x200) return;
    if (AIGetMode(arStunActor) < 0) return;
    ReturnEx(6037);
    return;
end
