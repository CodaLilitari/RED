    enabled = 1;
    if (IsMulti() && (IsServer() == 0)) return;
    SetPulse(0.05);
    SetTimer(60/hz);
    return;
pulse:
    if (enabled == 0) return;
    if (IsMulti() && (IsServer() == 0)) return;
    call checklife;
    if (enabled == 0) return;
    now = (GetFlexGameTime()-epoch)*hz;
    while (now >= 240) now = now - 240;
    q = now / 4;
    sample = q | 0;
    if (sample > 59) sample = 59;
    q = q - sample;
    offset = VectorAdd(VectorScale(pose0[sample],1-q),VectorScale(pose0[sample+1],q));
    pos = VectorAdd(GetThingPos(body),VectorAdd(VectorScale(GetThingRVec(body),VectorX(offset)),VectorAdd(VectorScale(GetThingLVec(body),VectorY(offset)),VectorScale(GetThingUVec(body),VectorZ(offset)))));
    call place;
    if (enabled == 0) return;
    call aim;
    SyncThingPos(head);
    return;
checklife:
    if ((GetThingType(body) != 7) || (GetThingSignature(body) != bodySig) || (GetThingType(head) != 7) || (GetThingSignature(head) != headSig) || ((GetThingFlags(body) & 0x80202) != 0) || ((GetThingFlags(head) & 0x80202) != 0)) call halt;
    return;
aim:
    wanted = VectorAdd(VectorScale(rest0[sample],1-q),VectorScale(rest0[sample+1],q));
    look = VectorAdd(VectorScale(GetThingRVec(body),VectorX(wanted)),VectorAdd(VectorScale(GetThingLVec(body),VectorY(wanted)),VectorScale(GetThingUVec(body),VectorZ(wanted))));
    if ((phase == 1) && (target >= 0))
    {
        if ((GetThingType(target) != 10) || (GetThingSignature(target) != targetSig) || (GetThingHealth(target) <= 0) || ((GetThingFlags(target) & 0x80202) != 0) || (GetPlayerNum(target) < 0))
        { target = -1; phase = 0; SetTimer(7/hz); }
        else
        {
            aimDelta = VectorSub(GetThingPos(target),GetThingPos(head));
            delta = aimDelta;
            call clampaim;
            # A positive ray cannot reach inside the rotating muzzle sphere.
            # Keep the original bounded aim for these close/degenerate targets.
            if (VectorLen(aimDelta) > VectorLen(muzzle))
            {
                # Forward muzzle offset is on the ray. Compensate only right/up.
                # Eight bounded passes use the actual native SetThingLook frame.
                for (aimStep=0; aimStep<8; aimStep=aimStep+1)
                {
                    SetThingLook(head,VectorNorm(look));
                    wanted = VectorAdd(VectorScale(GetThingRVec(head),VectorX(muzzle)),VectorScale(GetThingUVec(head),VectorZ(muzzle)));
                    delta = VectorSub(aimDelta,wanted);
                    call clampaim;
                }
            }
        }
    }
    if (VectorLen(look)>0.00001) SetThingLook(head,VectorNorm(look));
    return;
clampaim:
    forward = -VectorDot(delta,GetThingLVec(body));
    side = -VectorDot(delta,GetThingRVec(body));
    if (forward < 0.0001) forward = 0.0001;
    if (side > forward) side = forward;
    if (side < -forward) side = -forward;
    horizontal = VectorLen(VectorSet(forward,side,0));
    vertical = VectorDot(delta,GetThingUVec(body));
    if (vertical > horizontal*0.726542528) vertical = horizontal*0.726542528;
    if (vertical < -horizontal*0.414213562) vertical = -horizontal*0.414213562;
    look = VectorAdd(VectorScale(GetThingLVec(body),-forward),VectorAdd(VectorScale(GetThingRVec(body),-side),VectorScale(GetThingUVec(body),vertical)));
    return;

timer:
    if (enabled == 0) return;
    if (IsMulti() && (IsServer() == 0)) return;
    call checklife;
    if (enabled == 0) return;
    if (phase == 0)
    {
        target = -1;
        for (scan=0; (scan<8) && (target<0); scan=scan+1)
        {
            candidate = GetPlayerThing(scan);
            if (candidate >= 0)
            {
                if ((GetThingType(candidate)==10) && (GetThingHealth(candidate)>0) && ((GetThingFlags(candidate) & 0x80202)==0) && (GetPlayerNum(candidate)>=0))
                {
                    delta = VectorSub(GetThingPos(candidate),GetThingPos(head));
                    forward = -VectorDot(delta,GetThingLVec(body));
                    side = -VectorDot(delta,GetThingRVec(body));
                    if ((forward>0) && (forward<5) && (side<=2*forward) && (side>=-2*forward)) target=candidate;
                }
            }
        }
        if (target < 0) { SetTimer(7/hz); return; }
        targetSig = GetThingSignature(target);
        phase = 1;
        shots = 0;
        SetTimer(90/hz);
        return;
    }
    if (phase == 1)
    {
        call aim;
        if (target < 0) return;
        shot = FireProjectile(head,shotTemplate,fireSound,-1,muzzle,'0 0 0',1,0,0,0);
        shots = shots + 1;
        if (shots < 2)
        {
            delay = Rand()*12;
            dummy = delay | 0;
            if (dummy > 11) dummy = 11;
            SetTimer((15+dummy)/hz);
        }
        else
        {
            target = -1;
            phase = 2;
            delay = Rand()*60;
            dummy = delay | 0;
            if (dummy > 59) dummy = 59;
            SetTimer((60+dummy)/hz);
        }
        return;
    }
    phase = 0;
    SetTimer(15/hz);
    return;
findsector:
    sectorId = -1;
    if ((sectorId < 0) && (VectorX(pos) >= -16.000000000) && (VectorX(pos) <= -8.000000000) && (VectorY(pos) >= -24.000000000) && (VectorY(pos) <= -16.000000000) && (VectorZ(pos) >= -2.274000000) && (VectorZ(pos) <= 48.000000000)) sectorId = 0;
    if ((sectorId < 0) && (VectorX(pos) >= -16.000000000) && (VectorX(pos) <= -8.000000000) && (VectorY(pos) >= -16.000000000) && (VectorY(pos) <= -8.000000000) && (VectorZ(pos) >= -2.274000000) && (VectorZ(pos) <= 48.000000000)) sectorId = 1;
    if ((sectorId < 0) && (VectorX(pos) >= -16.000000000) && (VectorX(pos) <= -8.000000000) && (VectorY(pos) >= -8.000000000) && (VectorY(pos) <= 0.000000000) && (VectorZ(pos) >= -2.274000000) && (VectorZ(pos) <= 48.000000000)) sectorId = 2;
    if ((sectorId < 0) && (VectorX(pos) >= -16.000000000) && (VectorX(pos) <= -8.000000000) && (VectorY(pos) >= 0.000000000) && (VectorY(pos) <= 8.000000000) && (VectorZ(pos) >= -2.274000000) && (VectorZ(pos) <= 48.000000000)) sectorId = 3;
    if ((sectorId < 0) && (VectorX(pos) >= -16.000000000) && (VectorX(pos) <= -8.000000000) && (VectorY(pos) >= 8.000000000) && (VectorY(pos) <= 16.000000000) && (VectorZ(pos) >= -2.274000000) && (VectorZ(pos) <= 48.000000000)) sectorId = 4;
    if ((sectorId < 0) && (VectorX(pos) >= -16.000000000) && (VectorX(pos) <= -8.000000000) && (VectorY(pos) >= 16.000000000) && (VectorY(pos) <= 24.000000000) && (VectorZ(pos) >= -2.274000000) && (VectorZ(pos) <= 48.000000000)) sectorId = 5;
    if ((sectorId < 0) && (VectorX(pos) >= -8.000000000) && (VectorX(pos) <= 0.000000000) && (VectorY(pos) >= -24.000000000) && (VectorY(pos) <= -16.000000000) && (VectorZ(pos) >= -2.274000000) && (VectorZ(pos) <= 48.000000000)) sectorId = 6;
    if ((sectorId < 0) && (VectorX(pos) >= -8.000000000) && (VectorX(pos) <= 0.000000000) && (VectorY(pos) >= -16.000000000) && (VectorY(pos) <= -8.000000000) && (VectorZ(pos) >= -2.274000000) && (VectorZ(pos) <= 48.000000000)) sectorId = 7;
    if ((sectorId < 0) && (VectorX(pos) >= -8.000000000) && (VectorX(pos) <= 0.000000000) && (VectorY(pos) >= -8.000000000) && (VectorY(pos) <= 0.000000000) && (VectorZ(pos) >= -2.274000000) && (VectorZ(pos) <= 48.000000000)) sectorId = 8;
    if ((sectorId < 0) && (VectorX(pos) >= -8.000000000) && (VectorX(pos) <= 0.000000000) && (VectorY(pos) >= 0.000000000) && (VectorY(pos) <= 8.000000000) && (VectorZ(pos) >= -2.274000000) && (VectorZ(pos) <= 48.000000000)) sectorId = 9;
    if ((sectorId < 0) && (VectorX(pos) >= -8.000000000) && (VectorX(pos) <= 0.000000000) && (VectorY(pos) >= 8.000000000) && (VectorY(pos) <= 16.000000000) && (VectorZ(pos) >= -2.274000000) && (VectorZ(pos) <= 48.000000000)) sectorId = 10;
    if ((sectorId < 0) && (VectorX(pos) >= -8.000000000) && (VectorX(pos) <= 0.000000000) && (VectorY(pos) >= 16.000000000) && (VectorY(pos) <= 24.000000000) && (VectorZ(pos) >= -2.274000000) && (VectorZ(pos) <= 48.000000000)) sectorId = 11;
    if ((sectorId < 0) && (VectorX(pos) >= 0.000000000) && (VectorX(pos) <= 8.000000000) && (VectorY(pos) >= -24.000000000) && (VectorY(pos) <= -16.000000000) && (VectorZ(pos) >= -2.274000000) && (VectorZ(pos) <= 48.000000000)) sectorId = 12;
    if ((sectorId < 0) && (VectorX(pos) >= 0.000000000) && (VectorX(pos) <= 8.000000000) && (VectorY(pos) >= -16.000000000) && (VectorY(pos) <= -8.000000000) && (VectorZ(pos) >= -2.274000000) && (VectorZ(pos) <= 48.000000000)) sectorId = 13;
    if ((sectorId < 0) && (VectorX(pos) >= 0.000000000) && (VectorX(pos) <= 8.000000000) && (VectorY(pos) >= -8.000000000) && (VectorY(pos) <= 0.000000000) && (VectorZ(pos) >= -2.274000000) && (VectorZ(pos) <= 48.000000000)) sectorId = 14;
    if ((sectorId < 0) && (VectorX(pos) >= 0.000000000) && (VectorX(pos) <= 8.000000000) && (VectorY(pos) >= 0.000000000) && (VectorY(pos) <= 8.000000000) && (VectorZ(pos) >= -2.274000000) && (VectorZ(pos) <= 48.000000000)) sectorId = 15;
    if ((sectorId < 0) && (VectorX(pos) >= 0.000000000) && (VectorX(pos) <= 8.000000000) && (VectorY(pos) >= 8.000000000) && (VectorY(pos) <= 16.000000000) && (VectorZ(pos) >= -2.274000000) && (VectorZ(pos) <= 48.000000000)) sectorId = 16;
    if ((sectorId < 0) && (VectorX(pos) >= 0.000000000) && (VectorX(pos) <= 8.000000000) && (VectorY(pos) >= 16.000000000) && (VectorY(pos) <= 24.000000000) && (VectorZ(pos) >= -2.274000000) && (VectorZ(pos) <= 48.000000000)) sectorId = 17;
    if ((sectorId < 0) && (VectorX(pos) >= 8.000000000) && (VectorX(pos) <= 16.000000000) && (VectorY(pos) >= -24.000000000) && (VectorY(pos) <= -16.000000000) && (VectorZ(pos) >= -2.274000000) && (VectorZ(pos) <= 48.000000000)) sectorId = 18;
    if ((sectorId < 0) && (VectorX(pos) >= 8.000000000) && (VectorX(pos) <= 16.000000000) && (VectorY(pos) >= -16.000000000) && (VectorY(pos) <= -8.000000000) && (VectorZ(pos) >= -2.274000000) && (VectorZ(pos) <= 48.000000000)) sectorId = 19;
    if ((sectorId < 0) && (VectorX(pos) >= 8.000000000) && (VectorX(pos) <= 16.000000000) && (VectorY(pos) >= -8.000000000) && (VectorY(pos) <= 0.000000000) && (VectorZ(pos) >= -2.274000000) && (VectorZ(pos) <= 48.000000000)) sectorId = 20;
    if ((sectorId < 0) && (VectorX(pos) >= 8.000000000) && (VectorX(pos) <= 16.000000000) && (VectorY(pos) >= 0.000000000) && (VectorY(pos) <= 8.000000000) && (VectorZ(pos) >= -2.274000000) && (VectorZ(pos) <= 48.000000000)) sectorId = 21;
    if ((sectorId < 0) && (VectorX(pos) >= 8.000000000) && (VectorX(pos) <= 16.000000000) && (VectorY(pos) >= 8.000000000) && (VectorY(pos) <= 16.000000000) && (VectorZ(pos) >= -2.274000000) && (VectorZ(pos) <= 48.000000000)) sectorId = 22;
    if ((sectorId < 0) && (VectorX(pos) >= 8.000000000) && (VectorX(pos) <= 16.000000000) && (VectorY(pos) >= 16.000000000) && (VectorY(pos) <= 24.000000000) && (VectorZ(pos) >= -2.274000000) && (VectorZ(pos) <= 48.000000000)) sectorId = 23;
    return;
place:
    call findsector;
    if (sectorId < 0) { call halt; return; }
    if (GetThingSector(head) != sectorId) TeleportThing(head, anchor0[sectorId]);
    SetThingPos(head, pos);
    return;
shutdown:
    call halt;
    return;
halt:
    SetPulse(0);
    SetTimer(0);
    enabled = 0;
    if ((IsMulti()==0) || IsServer())
        if ((GetThingType(head)==7) && (GetThingSignature(head)==headSig)) DestroyThing(head);
    return;

end
