int         valid=0 local

# Original retail ParseMessage names the handler from the value token, so use
# the registered message names directly. Reconstructed-engine aliases differ.
message     user0
message     user1
message     user2
message     user3
message     user4
message     user5
message     user6

end

code

readlane:
    valid = 0;
    if (GetSenderType() != 9) return;
    caller = GetSenderRef();
    if (caller < 0) return;
    playernum = GetParam(0);
    lease = GetParam(1);
    if ((playernum < 0) || (playernum >= 32)) return;
    if (playernum >= GetMaxPlayers()) return;
    valid = 1;
    return;

readlife:
    call readlane;
    if (valid == 0) return;
    valid = 0;
    rider = GetPlayerThing(playernum);
    if (rider < 0) return;
    if (GetThingType(rider) != 10) return;
    signature = GetThingSignature(rider);
    valid = 1;
    return;

user0:
    ReturnEx(0);
    if (IsMulti() && (IsServer() == 0)) return;
    call readlife;
    if (valid == 0) return;
    if (lease < 1) return;
    if (GetPlayerNum(rider) != playernum) return;
    if ((rider == GetLocalPlayerThing()) && (GetThingHealth(rider) <= 0)) return;
    if (authsig0[playernum] != signature) authowner0[playernum] = -1;
    if (authowner0[playernum] >= 0)
    {
        if ((authowner0[playernum] == caller) && (authlease0[playernum] == lease)) ReturnEx(1);
        return;
    }
    authowner0[playernum] = caller;
    authlease0[playernum] = lease;
    authsig0[playernum] = signature;
    ReturnEx(1);
    return;

user1:
    ReturnEx(0);
    if (IsMulti() && (IsServer() == 0)) return;
    call readlane;
    if (valid == 0) return;
    if (lease < 1) return;
    if ((authowner0[playernum] != caller) || (authlease0[playernum] != lease)) return;
    authowner0[playernum] = -1;
    authlease0[playernum] = -1;
    authsig0[playernum] = -1;
    ReturnEx(1);
    return;

user2:
    ReturnEx(0);
    call readlife;
    if (valid == 0) return;
    if (lease < 1) return;
    if (GetPlayerNum(rider) != playernum) return;
    if ((rider == GetLocalPlayerThing()) && (GetThingHealth(rider) <= 0)) return;
    if (viewsig0[playernum] != signature) viewowner0[playernum] = -1;
    if (viewowner0[playernum] >= 0)
    {
        if ((viewowner0[playernum] == caller) && (viewlease0[playernum] == lease)) ReturnEx(1);
        return;
    }
    viewowner0[playernum] = caller;
    viewlease0[playernum] = lease;
    viewsig0[playernum] = signature;
    ReturnEx(1);
    return;

user3:
    ReturnEx(0);
    call readlife;
    if (valid == 0) return;
    if (lease < 1) return;
    if (viewsig0[playernum] != signature) return;
    if ((viewowner0[playernum] != caller) || (viewlease0[playernum] != lease)) return;
    ReturnEx(1);
    return;

user4:
    ReturnEx(0);
    call readlife;
    if (valid == 0) return;
    if (lease < 1) return;
    if (viewsig0[playernum] != signature) return;
    if ((viewowner0[playernum] != caller) || (viewlease0[playernum] != lease)) return;
    viewowner0[playernum] = -1;
    viewlease0[playernum] = -1;
    viewsig0[playernum] = -1;
    ReturnEx(1);
    return;

user5:
    ReturnEx(0);
    call readlife;
    if (valid == 0) return;
    # Read-only: stale claims are pruned on acquisition, never by this query.
    # Read the signature as a native int, not a potentially lossy float param.
    if ((authowner0[playernum] >= 0) && (authsig0[playernum] == signature)) ReturnEx(1);
    if ((viewowner0[playernum] >= 0) && (viewsig0[playernum] == signature)) ReturnEx(1);
    return;

# Read-only route for the Bryar wrapper; no claim can be created here.
user6:
    ReturnEx(-1);
    call readlife;
    if (valid == 0) return;
    if (viewsig0[playernum] != signature) return;
    if (viewowner0[playernum] < 0) return;
    if ((rider == GetLocalPlayerThing()) && (GetThingHealth(rider) <= 0)) return;
    ReturnEx(viewowner0[playernum]);
    return;

end
