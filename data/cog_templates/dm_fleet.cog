# Candidate08 fleet coordinator for original JKDF2. Native acceptance pending.
# Local-only synchronous API, called by the explicitly bound vehicle controllers.
# user0 host claim; user1 host release; user2 view claim; user3 view owns;
# user4 view release. Params are (player number, controller lease, 0, 0).
# user5 read-only busy(player number, 0, 0, 0), for the skin selector.
# Controller identity comes from the typed COG sender, never a float payload.
# Current native player signature is read locally and retained as an int.
# No player userdata, heap, network sends, timers, movement or model mutations.
# Fixed32player lanes match inspected GetAbsoluteMaxPlayers; GetMaxPlayers
# bounds are checked before any array access. Claims require an active living
# native type10 player. View owns/release accept an inactive or dead type10
# player so original departure/death cleanup can restore owned physics.
# Host release only retires a matching caller+lease record; it never changes
# an actor. A new native signature invalidates an old claim on acquisition.

flags=0x240

symbols

